# =============================================================================
# Elements ERP - Environment variables (example)
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Supabase (public: safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase service role (SERVER ONLY - full DB access, never sent to browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Direct Postgres connection, used only by migration/seed scripts ---
# Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Use the direct connection or the session pooler. URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Owner bootstrap: the email that automatically becomes the protected Owner ---
OWNER_EMAIL=owner@example.com
# Optional: password used only when the bootstrap script has to create the Owner auth user.
OWNER_INITIAL_PASSWORD=

# --- App ---
NEXT_PUBLIC_APP_NAME=Elements ERP
NEXT_PUBLIC_COMPANY_NAME=Elements Limited
